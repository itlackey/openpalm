# OpenPalm Voice (Kokoro TTS + Whisper STT) configuration
# ---
#
# This is a local inference server — runs entirely on LAN, no upstream
# API, no API key, no channel HMAC. It listens only on the
# `assistant_net` Docker network (no host port binding), so other
# services reach it as http://voice:8880.
#
# All values below are operator-tunable but optional. The compose
# overlay supplies safe defaults; leaving these blank uses those.

# faster-whisper model identifier. Use any of base.en, small.en, medium.en
# or the multilingual variants (base, small, medium). Larger models are
# more accurate but slower and use more RAM.
# @required
OP_VOICE_WHISPER_MODEL=base.en

# Default Kokoro voice ID. The bundled voices-v1.0.bin ships all 54
# voices (af_bella, am_michael, bf_emma, ...). Any value here can be
# overridden per-request by the `voice` field on /v1/audio/speech.
OP_VOICE_KOKORO_VOICE=af_bella

# Python logging level for the FastAPI app and engine wrappers.
# One of: debug, info, warning, error.
OP_VOICE_LOG_LEVEL=info
