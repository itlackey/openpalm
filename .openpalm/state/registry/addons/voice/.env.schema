# Voice channel configuration
# ---
#
# The voice addon serves a static web app that talks directly to
# OpenCode's session API in the browser — it does NOT round-trip through
# the guardian, so no CHANNEL_VOICE_SECRET HMAC is needed.
#
# These STT/TTS values seed the voice web app's first-load settings via
# GET /config/defaults. Once a user saves settings in the browser,
# localStorage wins and these defaults stop applying. Leaving every
# value empty falls back to the in-browser Web Speech API.
#
# Most STT_*/TTS_* values below are written by writeCapabilityVars() in
# @openpalm/lib from the stack.yml `capabilities.stt` / `.tts` blocks.
# TTS_API_KEY / STT_API_KEY are set explicitly by the operator (they
# travel to the browser, which is a different trust boundary from
# OpenCode's auth.json).

# Speech-to-Text (STT) base URL. Empty = use Web Speech API in browser.
# @required
STT_BASE_URL=

# Speech-to-Text (STT) API key for the chosen provider.
# @sensitive
STT_API_KEY=

# Speech-to-Text (STT) model identifier (e.g. whisper-1).
STT_MODEL=

# Speech-to-Text (STT) BCP-47 language tag (e.g. en-US).
STT_LANGUAGE=

# Text-to-Speech (TTS) base URL. Empty = use Web Speech API in browser.
# @required
TTS_BASE_URL=

# Text-to-Speech (TTS) API key for the chosen provider.
# @sensitive
TTS_API_KEY=

# Text-to-Speech (TTS) model identifier (e.g. tts-1).
TTS_MODEL=

# Text-to-Speech (TTS) voice preset (e.g. alloy, nova).
TTS_VOICE=
