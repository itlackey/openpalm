# Voice channel configuration
# ---
#
# The voice addon serves a static web app that talks directly to
# OpenCode's session API in the browser — it does NOT round-trip through
# the guardian, so no CHANNEL_VOICE_SECRET HMAC is needed.
#
# These STT/TTS values seed the voice web app's first-load settings via
# GET /config/defaults. Once a user saves settings in the browser,
# localStorage wins and these defaults stop applying.
#
# All STT_*/TTS_* values below are written by writeCapabilityVars() in
# @openpalm/lib from the stack.yml `capabilities.stt` / `.tts` blocks.

# Speech-to-Text (STT) defaults
STT_BASE_URL=
# @sensitive
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=

# Text-to-Speech (TTS) defaults
TTS_BASE_URL=
# @sensitive
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
