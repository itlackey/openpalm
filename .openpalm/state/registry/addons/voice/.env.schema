# OpenPalm Voice (Kokoro TTS + Whisper STT) configuration
# ---
#
# This is a local inference server — runs entirely on LAN, no upstream
# API, no API key, no channel HMAC. It listens only on the
# `assistant_net` Docker network (no host port binding), so other
# services reach it as http://voice:8880.
#
# All values below are operator-tunable but optional. The compose
# overlay supplies safe defaults; leaving these blank uses those.

# faster-whisper model identifier. The default `base.en` is BAKED INTO
# the image so cold-start is instant. Use any of small.en, medium.en, or
# the multilingual variants (base, small, medium) to swap; non-default
# sizes incur a one-time HuggingFace download to OP_VOICE_WHISPER_MODEL_DIR
# on first request. Larger = more accurate, slower, more RAM.
# @required
OP_VOICE_WHISPER_MODEL=base.en

# Default Kokoro voice ID. The image ships kokoro-v1.0.onnx and the full
# voices-v1.0.bin bundle (~340 MB) baked in under /opt/kokoro, so there
# is NO first-run download. Pick any of the 54 bundled voices
# (af_heart, am_michael, bf_isabella, bf_emma, ...); any value here can
# be overridden per-request by the `voice` field on /v1/audio/speech.
OP_VOICE_KOKORO_VOICE=bf_isabella

# Python logging level for the FastAPI app and engine wrappers.
# One of: debug, info, warning, error.
OP_VOICE_LOG_LEVEL=info
