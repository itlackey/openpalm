{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "brand": "#ff9d00",
    "brand_hover": "#e68a00",
    "success": "#40c057",
    "danger": "#fa5252",
    "warning": "#fd7e14",
    "info": "#339af0",
    "light_bg": "#ffffff",
    "light_bg_secondary": "#f9fafb",
    "light_bg_tertiary": "#f3f4f6",
    "light_surface": "#ffffff",
    "light_surface_alt": "#f6f8fa",
    "light_border": "#e5e7eb",
    "light_border_hover": "#d1d5db",
    "light_text": "#111827",
    "light_text_secondary": "#6b7280",
    "light_text_tertiary": "#9ca3af",
    "dark_bg": "#101418",
    "dark_bg_secondary": "#161c22",
    "dark_bg_tertiary": "#1d2630",
    "dark_surface": "#141a20",
    "dark_surface_alt": "#1a222c",
    "dark_border": "#2a3441",
    "dark_border_hover": "#374151",
    "dark_text": "#f3f4f6",
    "dark_text_secondary": "#cbd5e1",
    "dark_text_tertiary": "#94a3b8",
    "diff_added_bg_dark": "#163022",
    "diff_added_bg_light": "#e9f8ee",
    "diff_removed_bg_dark": "#351a1a",
    "diff_removed_bg_light": "#fdecec"
  },
  "theme": {
    "primary": {
      "dark": "brand",
      "light": "brand"
    },
    "secondary": {
      "dark": "dark_text_secondary",
      "light": "light_text_secondary"
    },
    "accent": {
      "dark": "brand_hover",
      "light": "brand_hover"
    },
    "error": {
      "dark": "danger",
      "light": "danger"
    },
    "warning": {
      "dark": "warning",
      "light": "warning"
    },
    "success": {
      "dark": "success",
      "light": "success"
    },
    "info": {
      "dark": "info",
      "light": "info"
    },
    "text": {
      "dark": "dark_text",
      "light": "light_text"
    },
    "textMuted": {
      "dark": "dark_text_tertiary",
      "light": "light_text_secondary"
    },
    "background": {
      "dark": "dark_bg_secondary",
      "light": "light_bg_secondary"
    },
    "backgroundPanel": {
      "dark": "dark_surface",
      "light": "light_surface"
    },
    "backgroundElement": {
      "dark": "dark_surface_alt",
      "light": "light_surface_alt"
    },
    "border": {
      "dark": "dark_border",
      "light": "light_border"
    },
    "borderActive": {
      "dark": "brand",
      "light": "brand"
    },
    "borderSubtle": {
      "dark": "dark_border_hover",
      "light": "light_border_hover"
    },
    "diffAdded": {
      "dark": "success",
      "light": "success"
    },
    "diffRemoved": {
      "dark": "danger",
      "light": "danger"
    },
    "diffContext": {
      "dark": "dark_text_tertiary",
      "light": "light_text_tertiary"
    },
    "diffHunkHeader": {
      "dark": "dark_text_secondary",
      "light": "light_text_secondary"
    },
    "diffHighlightAdded": {
      "dark": "success",
      "light": "success"
    },
    "diffHighlightRemoved": {
      "dark": "danger",
      "light": "danger"
    },
    "diffAddedBg": {
      "dark": "diff_added_bg_dark",
      "light": "diff_added_bg_light"
    },
    "diffRemovedBg": {
      "dark": "diff_removed_bg_dark",
      "light": "diff_removed_bg_light"
    },
    "diffContextBg": {
      "dark": "dark_surface",
      "light": "light_surface"
    },
    "diffLineNumber": {
      "dark": "dark_text_tertiary",
      "light": "light_text_tertiary"
    },
    "diffAddedLineNumberBg": {
      "dark": "diff_added_bg_dark",
      "light": "diff_added_bg_light"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diff_removed_bg_dark",
      "light": "diff_removed_bg_light"
    },
    "markdownText": {
      "dark": "dark_text",
      "light": "light_text"
    },
    "markdownHeading": {
      "dark": "brand",
      "light": "brand_hover"
    },
    "markdownLink": {
      "dark": "info",
      "light": "info"
    },
    "markdownLinkText": {
      "dark": "brand",
      "light": "brand_hover"
    },
    "markdownCode": {
      "dark": "success",
      "light": "success"
    },
    "markdownBlockQuote": {
      "dark": "dark_text_tertiary",
      "light": "light_text_tertiary"
    },
    "markdownEmph": {
      "dark": "warning",
      "light": "warning"
    },
    "markdownStrong": {
      "dark": "brand",
      "light": "brand"
    },
    "markdownHorizontalRule": {
      "dark": "dark_border",
      "light": "light_border"
    },
    "markdownListItem": {
      "dark": "brand",
      "light": "brand_hover"
    },
    "markdownListEnumeration": {
      "dark": "warning",
      "light": "warning"
    },
    "markdownImage": {
      "dark": "info",
      "light": "info"
    },
    "markdownImageText": {
      "dark": "dark_text_secondary",
      "light": "light_text_secondary"
    },
    "markdownCodeBlock": {
      "dark": "dark_text",
      "light": "light_text"
    },
    "syntaxComment": {
      "dark": "dark_text_tertiary",
      "light": "light_text_tertiary"
    },
    "syntaxKeyword": {
      "dark": "brand",
      "light": "brand_hover"
    },
    "syntaxFunction": {
      "dark": "info",
      "light": "info"
    },
    "syntaxVariable": {
      "dark": "dark_text",
      "light": "light_text"
    },
    "syntaxString": {
      "dark": "success",
      "light": "success"
    },
    "syntaxNumber": {
      "dark": "warning",
      "light": "warning"
    },
    "syntaxType": {
      "dark": "brand",
      "light": "brand_hover"
    },
    "syntaxOperator": {
      "dark": "dark_text_secondary",
      "light": "light_text_secondary"
    },
    "syntaxPunctuation": {
      "dark": "dark_text_tertiary",
      "light": "light_text_tertiary"
    }
  }
}
