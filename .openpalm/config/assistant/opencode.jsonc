{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./instructions/core.md", "./instructions/conversation.md", "./persona.md"],
  "plugin": [
    "akm-opencode@latest"
  ],

  // MCP consume-only example: OpenCode can connect to external MCP servers,
  // but it does not serve MCP itself. Seed-only file: existing installs keep
  // their current config unless the operator edits it.
  // "mcp": {
  //   "docs": {
  //     "type": "local",
  //     "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/work"]
  //   },
  //   "local-http": {
  //     "type": "remote",
  //     "url": "http://127.0.0.1:8787/mcp"
  //   }
  // },

  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": false
  },

  "permission": {
    // Tool gates: pause execution with `permission.asked` so a human (or a
    // non-interactive channel policy) approves before the tool runs. Verified
    // end-to-end on OpenCode 1.15.13 (design §1.2). The guardian relays the
    // permission.asked frame over /event and authorizes the reply by requestID.
    "bash": "ask",
    "edit": "ask",
    "task": "ask",

    "read": {
      "/home/opencode/.local/share/opencode/auth.json": "deny",
      "/home/opencode/.local/share/opencode/mcp-auth.json": "deny"
    },

    "external_directory": {
      "/tmp": "allow",
      "/work": "allow",
      "/stash": "allow",
      "/host-stash": "allow",
      "/etc/akm": "allow"
    }
  }
}
