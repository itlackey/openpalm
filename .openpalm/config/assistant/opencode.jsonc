{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./instructions/core.md", "./persona.md"],
  "plugin": [
    "akm-opencode@latest"
  ],

  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": false
  },

  "permission": {
    "read": {
      "/home/opencode/.local/share/opencode/auth.json": "deny",
      "/home/opencode/.local/share/opencode/mcp-auth.json": "deny"
    },

    "external_directory": {
      "/tmp": "allow",
      "/work": "allow",
      "/stash": "allow",
      "/host-stash": "allow",
      "/etc/akm": "allow"
    }
  }
}
