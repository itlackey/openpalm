{
  "baseUrl": "http://localhost:5173",
  "outDir": "../../.reviews/ux-audit",
  "widths": [320, 360, 375, 414, 480, 640, 768, 900, 1024, 1280, 1440],
  "themes": [
    { "id": "light", "init": null },
    { "id": "dark", "init": { "localStorage": { "openpalm.theme": "dark" } } }
  ],
  "auth": {
    "passwordSelector": "input[autocomplete=\"current-password\"]",
    "submitSelector": "form.s-gate-form button[type=\"submit\"]",
    "readySelector": ".chat-frame-header, header.navbar",
    "passwordEnv": "OP_UI_LOGIN_PASSWORD"
  },
  "states": [
    {
      "id": "chat",
      "path": "/chat",
      "waitFor": ".chat-frame-header"
    },
    {
      "id": "chat-assistants",
      "path": "/chat",
      "waitFor": "#s-chat-side-panel",
      "setup": "(async () => { document.querySelector('button[aria-label=\"Assistants\"]')?.click(); await new Promise(r => setTimeout(r, 300)); })()"
    },
    {
      "id": "chat-voice",
      "path": "/chat",
      "waitFor": "#s-chat-side-panel",
      "setup": "(async () => { document.querySelector('button[aria-label=\"Voice\"]')?.click(); await new Promise(r => setTimeout(r, 300)); })()"
    },
    { "id": "admin-overview", "path": "/host", "waitFor": "header.navbar" },
    {
      "id": "admin-providers",
      "path": "/host?tab=connections",
      "waitFor": "header.navbar"
    },
    {
      "id": "admin-knowledge",
      "path": "/host?tab=akm",
      "waitFor": "header.navbar"
    },
    {
      "id": "device-voice",
      "path": "/settings/voice",
      "waitFor": ".voice-settings"
    },
    {
      "id": "admin-secrets",
      "path": "/host?tab=secrets",
      "waitFor": "header.navbar"
    },
    {
      "id": "admin-addons",
      "path": "/host?tab=addons",
      "waitFor": "header.navbar"
    }
  ],
  "axeWidths": [375, 1280],
  "screenshot": true
}
