{
  "name": "@openpalm/ui",
  "description": "SvelteKit web UI and API for OpenPalm stack management",
  "version": "0.13.0-beta.25",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/itlackey/openpalm.git",
    "directory": "packages/ui"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "svelte-kit sync && OP_SVELTEKIT_OUT_DIR=.svelte-kit/dev PORT=${PORT:-5173} vite dev",
    "ux:audit": "NODE_PATH=\"$PWD/node_modules\" bun \"${AKM_HOME:-$HOME/akm}/skills/web-ux/ux-dom-audit/scripts/audit.ts\" e2e/ux-audit.config.json",
    "ux:audit:wizard": "NODE_PATH=\"$PWD/node_modules\" bun \"${AKM_HOME:-$HOME/akm}/skills/web-ux/ux-dom-audit/scripts/audit.ts\" e2e/ux-audit.wizard.config.json",
    "dev:local": "svelte-kit sync && OP_SVELTEKIT_OUT_DIR=.svelte-kit/dev PORT=${PORT:-5173} OP_OPENCODE_URL=${OP_OPENCODE_URL:-http://localhost:3810} vite dev",
    "build": "svelte-kit sync && vite build && node scripts/stamp-version.mjs",
    "clean:build": "rm -rf .svelte-kit build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && npm run test:pwa:run",
    "test:pwa:run": "playwright test --config playwright.pwa.config.ts",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:unit": "vitest",
    "test:browsers": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node build/index.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@openpalm/lib": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "markdown-it": "^14.3.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "uqr": "0.1.3",
    "vite": "^8.1.5",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
