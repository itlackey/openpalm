{
  "name": "@openpalm/ui",
  "description": "SvelteKit web UI and API for OpenPalm stack management",
  "version": "0.12.44-beta.2",
  "license": "MPL-2.0",
  "type": "module",
  "//minHarnessContract": "Minimum native Electron harness contract this UI build requires (design §5.3). The harness refuses to self-update onto a build whose minHarnessContract exceeds the contract it provides and prompts an app re-download instead. Bump ONLY when the UI starts depending on a new IPC method / spawn env key; keep in lockstep with packages/electron/src/harness-contract.ts HARNESS_CONTRACT_VERSION.",
  "minHarnessContract": 1,
  "repository": {
    "type": "git",
    "url": "https://github.com/itlackey/openpalm.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "PORT=${PORT:-5173} vite dev",
    "ux:audit": "NODE_PATH=\"$PWD/node_modules\" bun \"${AKM_HOME:-$HOME/akm}/skills/web-ux/ux-dom-audit/scripts/audit.ts\" e2e/ux-audit.config.json",
    "ux:audit:wizard": "NODE_PATH=\"$PWD/node_modules\" bun \"${AKM_HOME:-$HOME/akm}/skills/web-ux/ux-dom-audit/scripts/audit.ts\" e2e/ux-audit.wizard.config.json",
    "dev:local": "PORT=${PORT:-5173} OP_OPENCODE_URL=${OP_OPENCODE_URL:-http://localhost:3800} vite dev",
    "build": "svelte-kit sync && vite build && node scripts/stamp-version.mjs",
    "clean:build": "rm -rf .svelte-kit build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:unit": "vitest",
    "test:browsers": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node build/index.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@openpalm/lib": "workspace:*",
    "@playwright/test": "^1.58.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.53.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.3.0",
    "markdown-it": "^14.1.1",
    "playwright": "^1.58.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.0.1",
    "svelte": "^5.53.5",
    "svelte-check": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.14",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.18",
    "vitest-browser-svelte": "^2.0.2",
    "yaml": "^2.8.0"
  }
}
