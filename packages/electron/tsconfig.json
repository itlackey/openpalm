{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/admin-main.ts", "src/admin-preload.ts", "src/admin-types.ts", "src/admin-domain.ts"],
	"exclude": ["node_modules", "dist", "test"]
}
