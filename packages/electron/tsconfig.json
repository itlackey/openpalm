{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": [
		"src/admin-main.ts",
		"src/admin-app.ts",
		"src/admin-e2e.ts",
		"src/admin-preload.ts",
		"src/admin-types.ts",
		"src/admin-domain.ts",
		"src/admin-instances.ts"
	],
	"exclude": ["node_modules", "dist", "test"]
}
