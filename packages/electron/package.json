{
  "name": "@openpalm/electron",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "OpenPalm desktop app (Electron harness)",
  "license": "MPL-2.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "compile": "tsc",
    "build:mac": "tsc && electron-builder --mac",
    "build:linux": "tsc && electron-builder --linux",
    "build:win": "tsc && electron-builder --win",
    "test": "vitest run"
  },
  "dependencies": {
    "@openpalm/lib": ">=0.11.0 <1.0.0"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0"
  }
}
