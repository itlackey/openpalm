{
	"$schema": "https://opencode.ai/config.json",
	"share": "disabled",
	"autoupdate": false,
	"plugin": ["file:///etc/opencode/plugins/akm.ts"],
	"instructions": ["/etc/opencode/security.md"],
	"permission": {
		"external_directory": {
			"/stash/*": "allow",
			"/paperclip/instances/*/companies/*/agents/*/instructions/*": "allow",
			"/paperclip/instances/*/workspaces/*/*": "allow"
		}
	}
}
