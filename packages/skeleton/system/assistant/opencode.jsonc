{
	"$schema": "https://opencode.ai/config.json",
	"server": {
		"port": 4096,
		"hostname": "0.0.0.0",
		"mdns": false
	},
	"permission": {
		"bash": {
			"*": "allow",
			"rm -r *": "ask",
			"rm -rf *": "ask",
			"rm -fr *": "ask",
			"sudo *": "ask",
			"rm -rf /": "deny",
			"rm -fr /": "deny"
		},
		"edit": "allow",
		"task": "allow",
		"external_directory": {
			"/tmp/*": "allow",
			"/work/*": "allow",
			"/stash/*": "allow",
			"/etc/akm/*": "allow",
			"/home/opencode/.config/opencode/*": "allow"
		}
	}
}
