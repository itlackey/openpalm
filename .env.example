# OpenPalm Stack — Dev Environment Configuration
#
# Copy this file to .env and adjust paths as needed.
# Provider API keys and other secrets belong in knowledge/secrets/auth.json
# (akm secret store). User env lives in knowledge/env/user.env (akm env:user).
# Do not put real secrets in this file.

# ── Secrets ──────────────────────────────────────────────────────────
# Runtime secrets are loaded from knowledge/secrets/ (file secrets via Compose
# secrets:) and knowledge/env/user.env (akm env:user). Do NOT duplicate them
# here or this dev .env may shadow the real values.

# ── Paths (relative to repo root) ────────────────────────────────
# All directories (config/, knowledge/, data/, logs/) live under OP_HOME.
OP_HOME=.dev                    # Dev home directory (default runtime: ~/.openpalm)

# ── Images ───────────────────────────────────────────────────────────
# OP_IMAGE_NAMESPACE=openpalm
# OP_IMAGE_TAG=v0.8.0

# ── Core binds ───────────────────────────────────────────────────────
# OP_HOST_UI_PORT=3880
# OP_ASSISTANT_BIND_ADDRESS=127.0.0.1
# OP_ASSISTANT_PORT=3800
# OP_ASSISTANT_SSH_BIND_ADDRESS=127.0.0.1
# OP_ASSISTANT_SSH_PORT=2222
# OP_CHAT_BIND_ADDRESS=127.0.0.1
# OP_CHAT_PORT=3820
# OP_API_BIND_ADDRESS=127.0.0.1
# OP_API_PORT=3821
# OP_VOICE_BIND_ADDRESS=127.0.0.1
# OP_VOICE_PORT_HOST=8880

# ── User/Group (for bind mount permissions) ──────────────────────────
# OP_UID=1000
# OP_GID=1000

