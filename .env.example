# OpenPalm development environment
#
# Copy to .env only for local development. Do not put real credentials here.
# Provider OpenCode auth stays in knowledge/secrets/auth.json. Delegated UI,
# OpenCode-server, Guardian/API, portal, and bot credentials live under
# private/secrets/. AKM user env lives in knowledge/env/user.env and is loaded
# by scoped tools on demand, not by the assistant entrypoint.

# Paths
# OP_HOME contains config/, system/, state/, knowledge/, data/, workspace/,
# private/, and cache/.
OP_HOME=.dev

# Images
# OP_IMAGE_NAMESPACE=openpalm
# OP_ASSISTANT_VERSION=dev
# OP_GUARDIAN_VERSION=dev
# OP_PORTAL_VERSION=dev
# OP_VOICE_VERSION=latest

# Ports
# OP_HOST_UI_PORT=3880
# OP_UI_PORT=3800
# OP_ASSISTANT_PORT=3810
# OP_GUARDIAN_PORT=3830
# OP_GUARDIAN_ADMIN_PORT=3831
# OP_API_PORT=3821
# OP_VOICE_PORT_HOST=8880

# Flat service-specific binds. There is no global bind cascade.
# OP_UI_BIND_ADDRESS=127.0.0.1
# OP_ASSISTANT_BIND_ADDRESS=127.0.0.1
# OP_GUARDIAN_BIND_ADDRESS=127.0.0.1
# OP_API_BIND_ADDRESS=127.0.0.1
# Voice is always bound to literal 127.0.0.1; only its host port is configurable.

# Setup v2 writes these from the flat access booleans networkAccess,
# assistantDirect, guardianNetwork, and guardianOpenaiApi. These are generated
# consequences of those independent toggles. (OpenCode Basic auth is always on
# and is not a row here — the password is the op_opencode_password secret.)
# GUARDIAN_DIRECT_INGRESS=false

# Content validation is on in code and shipped Compose. Only explicit
# 0/false/no/off disables it.
# GUARDIAN_CONTENT_VALIDATION=1

# Runtime identity for bind-mount ownership
# OP_UID=1000
# OP_GID=1000
