# OpenPalm lean development environment
# Copy to .env only for local development. Never put credentials here.

OP_HOME=.dev

# Optional image/build pins
# OP_IMAGE_NAMESPACE=openpalm
# OP_ASSISTANT_VERSION=dev
# OP_GUARDIAN_VERSION=dev
# OP_PORTAL_VERSION=dev

# Development-only host access overrides. Installed stacks derive these from
# state/stack.json through `openpalm config`.
# OP_ASSISTANT_BIND_ADDRESS=127.0.0.1
# OP_ASSISTANT_PORT=3810
# OP_GUARDIAN_BIND_ADDRESS=127.0.0.1
# OP_GUARDIAN_PORT=3830
# OP_DISCORD_CREDENTIAL=discord
# OP_SLACK_CREDENTIAL=slack

# Runtime identity
# OP_UID=1000
# OP_GID=1000

# Exact browser origins for Guardian MCP, comma-separated
# GUARDIAN_ALLOWED_ORIGINS=https://agent.example.com

# Portal allowlists are IDs, not credentials
# DISCORD_ALLOWED_GUILDS=
# DISCORD_ALLOWED_ROLES=
# DISCORD_ALLOWED_USERS=
# DISCORD_BLOCKED_USERS=
# SLACK_ALLOWED_CHANNELS=
# SLACK_ALLOWED_USERS=
# SLACK_BLOCKED_USERS=

# Named Guardian keys belong in OP_HOME/state/credentials/<username>/key.
# Other runtime credentials belong in OP_HOME/state/secrets/. Provider auth
# belongs in OP_HOME/knowledge/secrets/auth.json.
